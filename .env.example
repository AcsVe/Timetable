# Copy to .env for local development. On Render set these as environment variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=1

# Later phases (email + push). Never commit real values.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
